# Copie para .env.local (local) ou cadastre na Vercel em Settings > Environment Variables.
# NUNCA coloque chaves reais neste arquivo nem no Git.

# OpenAI (Luna = roteirista/entrevistador, Sunburst = imagens)
OPENAI_API_KEY=
# Confirme os identificadores exatos dos modelos na sua conta OpenAI:
LUNA_MODEL=gpt-6-luna
SUNBURST_MODEL=gpt-image-2.5-sunburst

# ElevenLabs (narração e música)
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=cjVigY5qzO86Huf0OWal
ELEVEN_TTS_MODEL=eleven_multilingual_v2
ELEVEN_MUSIC_MODEL=music_v1

# Proteção contra gasto indevido durante os testes (recomendado).
# Se preenchido, a primeira tela pede este código e as rotas de API exigem o código.
ACCESS_CODE=
# O código só é exigido quando ACCESS_ENFORCE=1 (padrão: desligado).
ACCESS_ENFORCE=

# Supabase (registro de pedidos: respostas, consentimento, roteiro e tempo de cada etapa; sem fotos)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
